[
  {
    // Internet Identity fetches this over the non-raw canister domain and
    // requires a certified 200 with JSON content-type. It has no file
    // extension, so the asset canister would not infer the type, and dotfile
    // directories are skipped unless ignore is explicitly false.
    "match": ".well-known/ii-alternative-origins",
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    },
    "ignore": false
  },
  {
    "match": ".well-known/ii-app-metadata",
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    },
    "ignore": false
  },
  {
    "match": ".well-known/ii-auth-callbacks",
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    },
    "ignore": false
  },
  {
    "match": "images/**/*",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": "audio/**/*",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
    }
  },
  {
    "match": "bu/**/*",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
    }
  },
  {
    "match": "flc/**/*",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400"
    }
  },
  {
    "match": "**/*.png",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": "**/*.jpg",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": "**/*.jpeg",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": "**/*.webp",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": "**/*.svg",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": "**/*.ico",
    "headers": {
      "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": "**/*.woff2",
    "headers": {
      "Cache-Control": "public, max-age=31536000, immutable",
      "Access-Control-Allow-Origin": "*"
    }
  },
  {
    "match": "_next/**/*",
    "headers": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }
  },
  {
    "match": "**/*.html",
    "headers": {
      "Cache-Control": "public, max-age=0, must-revalidate"
    }
  },
  {
    // Deep links with runtime ids 404 without a fallback; onchain-shell.js
    // then swaps in the prerendered shell HTML before Next hydrates.
    "match": "**/*",
    "enable_aliasing": true,
    "disable_security_policy_warning": true
  }
]
