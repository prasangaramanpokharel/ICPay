# Custom HTTP headers for on-chain certified assets

# Next.js immutable assets & fonts
/_next/*
  Cache-Control: public, max-age=31536000, immutable

# Static media and images
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/audio/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/bu/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/flc/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# HTML pages must revalidate to pick up canister upgrades immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Internet Identity discovery files
/.well-known/ii-alternative-origins
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/.well-known/ii-app-metadata
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/.well-known/ii-auth-callbacks
  Content-Type: application/json
  Access-Control-Allow-Origin: *
