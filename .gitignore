backend/target/
.dfx/

# Package-manager and debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# staged Next export for the asset canister
backend/dist/
node_modules/
# Root package.json is CI-only (tsx); lockfile belongs in frontend/
/package-lock.json
# Root /pkg only — backend/pkg is the Motoko library and must stay tracked
/pkg
!backend/pkg/
!backend/testing/pkg/

